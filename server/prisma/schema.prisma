generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())

  name String

  email String @unique

  password String

  role UserRole @default(CITIZEN)

  reputation Int @default(0)

  isVerified Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  issues Issue[]
}

enum UserRole {
  CITIZEN
  VOLUNTEER
  AUTHORITY
  ADMIN
}

enum IssueCategory {
  ROAD
  WATER
  ELECTRICITY
  GARBAGE
  STREETLIGHT
  DRAINAGE
  PUBLIC_PROPERTY
  OTHER
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Issue {
  id String @id @default(cuid())

  title       String
  description String

  category IssueCategory
  status   IssueStatus   @default(OPEN)
  priority Priority      @default(MEDIUM)

  latitude  Float
  longitude Float
  address   String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([status])
  @@index([category])
}
